# ================================================================
# AgriBusiness Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ================================================================

# ----------------------------------------------------------------
# SUPABASE (auto-injected in Edge Function runtime — DO NOT set
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY manually in Edge Functions;
# they are always available as Deno.env.get(...) automatically)
# ----------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used by the frontend Supabase client
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ----------------------------------------------------------------
# CRON JOB SECURITY
# Generate with: openssl rand -hex 32
# Set ALSO in the Postgres database:
#   ALTER DATABASE postgres SET app.settings.cron_secret = 'VALUE';
# ----------------------------------------------------------------
CRON_SECRET=REPLACE_WITH_openssl_rand_hex_32_output

# ----------------------------------------------------------------
# OPENAI — Semantic embedding generation
# Model used: text-embedding-3-small (1536 dimensions)
# Get key at: https://platform.openai.com/api-keys
# Optional: if not set, search falls back to keyword-only mode
# ----------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# ----------------------------------------------------------------
# STRIPE — International card payments (EUR/USD/GBP)
# Dashboard: https://dashboard.stripe.com
# ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...           # or sk_test_... for development
STRIPE_WEBHOOK_SECRET=whsec_...         # from Stripe Webhook config page

# Stripe Price IDs — create products/prices in Stripe Dashboard first
STRIPE_PRICE_STARTER_MONTHLY=price_...   # PKR equivalent: ~$20/mo
STRIPE_PRICE_PRO_MONTHLY=price_...       # PKR equivalent: ~$50/mo
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_... # PKR equivalent: ~$120/mo

# ----------------------------------------------------------------
# JAZZCASH — PKR local payments (mobile wallet + local cards)
# Register at: https://merchant.jazzcash.com.pk
# Sandbox: https://sandbox.jazzcash.com.pk
# ----------------------------------------------------------------
JAZZCASH_MERCHANT_ID=MC12345
JAZZCASH_PASSWORD=YOUR_JAZZCASH_PASSWORD
JAZZCASH_INTEGRITY_SALT=YOUR_INTEGRITY_SALT

# API URL (use sandbox during development)
JAZZCASH_API_URL=https://payments.jazzcash.com.pk/ApplicationAPI/API/2.0/Purchase/DoMWalletTransaction
# JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/2.0/Purchase/DoMWalletTransaction

# ----------------------------------------------------------------
# COMMODITY DATA — KisanMandi / APTMA
# Option A: KisanMandi (preferred for Pakistan market data)
#   - Contact: info@kisanmandi.com or developer@kisanmandi.com
#   - Covers: all major mandis across Punjab, Sindh, KPK, Balochistan
# Option B: FAO GIEWS (free, no key — global reference prices only)
#   - URL: https://fpma.apps.fao.org/giews/food-prices/tool/public/api/
# Option C: AMIS (Agricultural Market Information System)
#   - URL: https://www.amis-outlook.org/
# ----------------------------------------------------------------
KISANMANDI_API_KEY=YOUR_KISANMANDI_API_KEY
KISANMANDI_API_URL=https://api.kisanmandi.com/v1/rates/today

# ----------------------------------------------------------------
# pg_cron → Postgres runtime settings
# Set these in Supabase SQL Editor ONCE per project:
#
#   ALTER DATABASE postgres
#     SET app.settings.supabase_url = 'https://REF.supabase.co';
#   ALTER DATABASE postgres
#     SET app.settings.cron_secret = 'YOUR_CRON_SECRET';
#
# These are referenced inside 07_functions.sql cron job definitions.
# ----------------------------------------------------------------
APP_SETTINGS_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
APP_SETTINGS_CRON_SECRET=REPLACE_WITH_CRON_SECRET_VALUE
